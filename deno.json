  },
  "imports": {
    "oak": "jsr:@oak/oak",
    "sanitize-html": "npm:sanitize-html@^2.17.6",
		"marked": "npm:marked@^15.0.12",
    "twilio": "npm:twilio"
  },
  "nodeModulesDir": "auto",
  "exclude": [
    "node_modules",
    "**/*.js"
  ]
}
