# Runtime
PORT=8000
DENO_ENV=production

# Public origin and trusted proxy configuration
FP_CICIS_PUBLIC_ORIGIN=https://gatewaycorporate.org
FP_CICIS_ALLOWED_ORIGINS=https://gatewaycorporate.org,https://www.gatewaycorporate.org
FP_CICIS_TRUSTED_PROXIES=127.0.0.1,::1
GCX_WS_TOKEN_FALLBACK=true

# Devicer
DEVICER_SNIPPET_KEY=
DEVICER_LICENSE_KEY=
DEVICER_DIAGNOSTICS=false
DEVICER_CANDIDATE_MIN_SCORE=40
DEVICER_STABILITY_WINDOW_SIZE=2
DEVICER_DEDUP_WINDOW_MS=30000

# Email delivery and career applications
RESEND_API_KEY=
CAREERS_EMAIL_FROM=
CAREERS_EMAIL_TO=office@gatewaycorporate.org
CONTACT_EMAIL_FROM=
CONTACT_EMAIL_TO=office@gatewaycorporate.org
RECAPTCHA_SECRET_KEY=

# Contact appointment availability
CONTACT_APPOINTMENT_SCARCITY_ENABLED=true
CONTACT_APPOINTMENT_SCARCITY_RATE=0.25

# Optional SMS notifications
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_NUMBER=
NOTIFICATION_NUMBER=

# Forum moderation
FORUM_MOD_PASSWORD=

# Experiments and telemetry
EXPERIMENTS_ENABLED=false
EXPERIMENTS_HOMEPAGE_ENABLED=true
EXPERIMENTS_PRODUCTS_PAGE_ENABLED=true
EXPERIMENTS_SERVICES_PAGE_ENABLED=true
EXPERIMENTS_HOMEPAGE_LEAD_PRODUCT=
EXPERIMENTS_DISABLED_IDS=
EXPERIMENTS_DISABLED_FILE=./content/experiment-control/disabled-experiments.json
EXPERIMENT_EVENTS_DIR=./content/experiment-events
EXPERIMENTS_AUTO_DISABLE=false
EXPERIMENT_GUARDRAIL_DROP_THRESHOLD=0.2
EXPERIMENT_GUARDRAIL_MIN_EXPOSURES=50
EXPERIMENT_ADMIN_KEY=
